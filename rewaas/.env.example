# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rewaas?schema=public"
# Long random string (openssl rand -base64 48). Signs customer/admin session cookies.
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="https://www.rewaas.com"

# --- Payments: Razorpay (UPI, cards, net banking, wallets, EMI) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set in Razorpay Dashboard > Webhooks, pointing to /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# --- Integrations (optional) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_GA_ID=""                  # Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=""       # Google Search Console HTML-tag verification token

# --- Media uploads (admin) ---
UPLOAD_DIR="./storage/uploads"

# --- First admin account created by `npm run db:seed` ---
SEED_ADMIN_EMAIL="admin@rewaas.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
